OPENROUTER_API_KEY=your_openrouter_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
PORT=3000

# Contractor portal sign-in (login is disabled until both are set)
CONTRACTOR_USERNAME=contractor
CONTRACTOR_PASSWORD=change_me_to_a_long_password
# Signs session cookies. Use a long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=replace_with_a_long_random_string
# Optional: session length in hours (default 8)
SESSION_TTL_HOURS=8
# Optional: comma-separated origins allowed to call the API cross-origin
ALLOWED_ORIGINS=
